# 由 init.sh 在服务器生成随机密码；使用十六进制字符，避免连接串转义问题
POSTGRES_PASSWORD=
DOMAIN=runchenqixiu.top

# 初次发布只开放本机端口；通过 SSH 隧道设置访问密码后，再改为 1 开放 HTTPS
PUBLIC_ENABLED=0
APP_PORT=3000

# 照片保存在独立 Docker 数据卷，更新应用镜像不会清空照片
STORAGE_DRIVER=local
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-shanghai
COS_PUBLIC_BASE=

OCR_AGENT_BASE_URL=https://api.deepseek.com
OCR_AGENT_MODEL=deepseek-flash
OCR_AGENT_API_KEY=
ICP_BEIAN=
POLICE_BEIAN=
