# ===== 数据库 =====
# 生产（腾讯云 CloudBase）：云开发 MySQL 的内网连接串，形如
#   mysql://root:密码@内网地址:3306/tcb
# 云托管服务必须开启「私有网络」并选中该 MySQL 所在 VPC，否则连不通
# 本地开发：先运行 npm run dev:db，再将本文件复制为 .env.local
# pg.mjs 只负责启动数据库，不会向 Next.js 进程注入环境变量
DATABASE_URL=postgresql://postgres:carweb-dev@127.0.0.1:5433/carweb

# ===== 图片存储 =====
# 存储驱动：cos = 腾讯云对象存储（生产）| local = 本地磁盘（本地开发零配置）
# 不填时自动判断：配了 COS_BUCKET 走 cos，否则回落 local
STORAGE_DRIVER=
# 腾讯云子账号密钥，建议只授予该存储桶的读写权限
COS_SECRET_ID=
COS_SECRET_KEY=
# 存储桶名称需带 APPID 后缀，形如 carweb-1250000000
COS_BUCKET=
COS_REGION=ap-shanghai
# 可选：CDN 加速域名（留空则用 COS 源站域名 https://<bucket>.cos.<region>.myqcloud.com）
COS_PUBLIC_BASE=

# 本地驱动可选的落盘目录（默认 <项目根>/.uploads）
UPLOAD_DIR=

# ===== 视觉 OCR Agent（可选，所有配置仅供服务端读取）=====
# 使用支持图片输入的模型，缺少密钥或识别失败时仍可手动录入
OCR_AGENT_BASE_URL=https://api.deepseek.com
OCR_AGENT_MODEL=deepseek-flash
OCR_AGENT_API_KEY=

# ===== 备案信息（备案通过后填写，展示在登录页底部）=====
# 形如：粤ICP备2026123456号-1
ICP_BEIAN=
# 公安联网备案通过后填写，形如：粤公网安备 44030502001234号
POLICE_BEIAN=
