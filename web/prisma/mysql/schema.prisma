// ⚠️ 本文件由 scripts/gen-mysql-schema.mjs 自动生成，请勿手动修改
// 源文件：prisma/schema.prisma（PostgreSQL）
// 用途：部署到腾讯云 CloudBase 云托管时连接云开发 MySQL
// 汽修管理系统数据库 Schema（PostgreSQL 版，自 SQLite 迁移而来）
// 金额字段一律为整数「分」，与前端 lib/money.ts 的换算约定保持一致
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 客户表
model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String    @unique
  address   String? @db.Text
  remark    String? @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  vehicles   Vehicle[]
  workOrders WorkOrder[]

  @@map("customers")
}

// 车辆表
model Vehicle {
  id          Int       @id @default(autoincrement())
  customerId  Int       @map("customer_id")
  plateNumber String    @map("plate_number")
  brand       String?
  model       String?
  year        Int?
  vin         String?
  color       String?
  remark      String? @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workOrders WorkOrder[]
  reminders  Reminder[]

  @@index([customerId])
  @@index([plateNumber])
  @@map("vehicles")
}

// 工单表（核心）
model WorkOrder {
  id               Int       @id @default(autoincrement())
  orderNo          String    @unique @map("order_no")
  customerId       Int       @map("customer_id")
  vehicleId        Int       @map("vehicle_id")
  status           String    @default("pending_inspection")
  source           String    @default("walk_in")
  complaint        String? @db.Text
  inspection       String?   @map("inspection") @db.Text
  mileageIn        Int?      @map("mileage_in")
  mileageOut       Int?      @map("mileage_out")
  quoteAmount      Int?      @map("quote_amount") // 单位:分
  discount         Int       @default(0) @map("discount") // 单位:分
  finalAmount      Int?      @map("final_amount") // 单位:分
  paidAmount       Int       @default(0) @map("paid_amount") // 单位:分
  quoteConfirmedAt DateTime? @map("quote_confirmed_at")
  repairStartedAt  DateTime? @map("repair_started_at")
  repairFinishedAt DateTime? @map("repair_finished_at")
  deliveredAt      DateTime? @map("delivered_at")
  cancelledAt      DateTime? @map("cancelled_at")
  cancelReason     String?   @map("cancel_reason") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  customer      Customer       @relation(fields: [customerId], references: [id])
  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id])
  checkinRecord CheckinRecord?
  checkinPhotos CheckinPhoto[]
  repairItems   RepairItem[]
  repairLogs    RepairLog[]
  additionalItems AdditionalItem[]
  qualityCheck  QualityCheck?
  settlement    Settlement?
  reminders     Reminder[]

  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@map("work_orders")
}

// 接车登记表
model CheckinRecord {
  id               Int      @id @default(autoincrement())
  workOrderId      Int      @unique @map("work_order_id")
  vehicleCondition String?  @map("vehicle_condition") @db.Text
  fuelLevel        String?  @map("fuel_level")
  itemsInCar       String?  @map("items_in_car") @db.Text
  checkinBy        String?  @map("checkin_by")
  createdAt        DateTime @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("checkin_records")
}

// 接车照片表（file_path 存 Vercel Blob 完整 URL）
model CheckinPhoto {
  id          Int      @id @default(autoincrement())
  workOrderId Int      @map("work_order_id")
  filePath    String   @map("file_path")
  description String? @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@map("checkin_photos")
}

// 维修项目/配件明细表
model RepairItem {
  id          Int      @id @default(autoincrement())
  workOrderId Int      @map("work_order_id")
  type        String // service(工时) / part(配件)
  name        String
  quantity    Float    @default(1)
  unitPrice   Int      @map("unit_price") // 单位:分；quantity 保持小数以支持 0.5 等数量
  subtotal    Int // 单位:分
  remark      String? @db.Text
  source      String   @default("quote") // quote / additional
  createdAt   DateTime @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@map("repair_items")
}

// 维修过程记录表
model RepairLog {
  id          Int      @id @default(autoincrement())
  workOrderId Int      @map("work_order_id")
  content     String @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@map("repair_logs")
}

// 增项表
model AdditionalItem {
  id          Int       @id @default(autoincrement())
  workOrderId Int       @map("work_order_id")
  name        String
  amount      Int // 单位:分
  reason      String? @db.Text
  status      String    @default("pending") // pending / confirmed / rejected
  confirmedAt DateTime? @map("confirmed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@map("additional_items")
}

// 质检表
model QualityCheck {
  id          Int      @id @default(autoincrement())
  workOrderId Int      @unique @map("work_order_id")
  result      String // pass / fail
  checkItems  String?  @map("check_items") @db.Text // JSON
  remark      String? @db.Text
  checkedBy   String?  @map("checked_by")
  createdAt   DateTime @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("quality_checks")
}

// 结算单表
model Settlement {
  id           Int      @id @default(autoincrement())
  workOrderId  Int      @unique @map("work_order_id")
  settlementNo String   @unique @map("settlement_no")
  totalAmount  Int      @map("total_amount") // 单位:分
  discount     Int      @default(0) // 单位:分
  actualAmount Int      @map("actual_amount") // 单位:分
  paidAmount   Int      @default(0) @map("paid_amount") // 单位:分
  status       String   @default("unpaid") // paid / unpaid
  remark       String? @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@map("settlements")
}

// 收款记录表
model Payment {
  id           Int      @id @default(autoincrement())
  settlementId Int      @map("settlement_id")
  amount       Int // 单位:分
  method       String   @default("cash") // cash/wechat/alipay/card/transfer
  type         String   @default("initial") // initial / supplement
  remark       String? @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  @@map("payments")
}

// 回访/保养提醒表
model Reminder {
  id           Int       @id @default(autoincrement())
  workOrderId  Int       @map("work_order_id")
  vehicleId    Int       @map("vehicle_id")
  type         String // maintenance / follow_up / collection（collection 为交车欠款催收）
  remindDate   DateTime  @map("remind_date")
  content      String? @db.Text
  status       String    @default("pending") // pending / done
  remindedAt   DateTime? @map("reminded_at")
  remindMethod String?   @map("remind_method")
  feedback     String? @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([vehicleId])
  @@index([status])
  @@map("reminders")
}

// 系统配置表（键值对）：访问密码哈希、会话签名密钥、登录防爆破计数等
model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
