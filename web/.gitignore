# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 环境变量模板需要入库，供部署时对照填写
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# serwist 构建产物
/public/sw.js

# 本地内嵌 Postgres 数据
/.pgdata

# 本地存储驱动落盘目录（STORAGE_DRIVER=local 时产生）
/.uploads
